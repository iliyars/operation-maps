<UserControl x:Class="OperationMaps.Wpf.Features.Components.ComponentRegimesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,0,0,16">
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap"/>
    <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
      <ItemsControl ItemsSource="{Binding OwnFormNotes}" Margin="0,0,0,8"
                    Visibility="{Binding IsCatalogPreview, Converter={StaticResource InverseBoolToVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,6">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="{Binding EffectiveValue}" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,3,0,0"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding ConditionChoices}" Margin="0,4,0,8"
                    Visibility="{Binding IsCatalogPreview, Converter={StaticResource InverseBoolToVis}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4" Foreground="{DynamicResource TextPrimaryBrush}">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Visibility="{Binding IsCatalogPreview, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">

        <ItemsControl ItemsSource="{Binding FormSections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,12,0,8">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Parameters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="90"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RowNumber}" Foreground="{DynamicResource TextMutedBrush}"/>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ItemsControl ItemsSource="{Binding Conditions}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3">
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,3,0,0"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Pins, StringFormat='Выводы: {0}'}" Foreground="{DynamicResource TextMutedBrush}"
                             Visibility="{Binding HasPins, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding EffectiveValue}" TextWrapping="Wrap" MaxWidth="180"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </StackPanel>
</UserControl>
