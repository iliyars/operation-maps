<UserControl x:Class="OperationMaps.Wpf.Features.Components.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OperationMaps.Wpf.Features.Components"
             mc:Ignorable="d"
             Background="{DynamicResource BgAppBrush}">

    <UserControl.Resources>

        <Style x:Key="StatusBadge"
                TargetType="Border">
            <Setter Property="CornerRadius"
                    Value="4"/>
            <Setter Property="Padding"
                    Value="6,2"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="FilterTab"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="12,6"/>
            <Setter Property="Margin"
                    Value="0,0,4,0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- An underline alone read as plain text, not as a clickable
                             segmented control — a filled pill is a much stronger signal
                             for "these three are one mutually-exclusive control". -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource BgHoverBrush}"/>
                            </Trigger>
                            <!-- Active tab: bound via Tag (see EnumEqualsToBoolConverter) since
                                 Button has no built-in checked state to compare the shared
                                 ActiveFilter against. -->
                            <Trigger Property="Tag"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource StatusInfoBgBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource StatusInfoBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading — the sidebar highlight alone is a weak signal for
             which screen is active; every content area should restate it. -->
        <TextBlock Grid.Row="0"
                   Text="Компоненты"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="16,14,16,4"/>

        <!-- SEARCH + FILTER TABS -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search + details-pane toggle -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BgPanelBrush}"
                        Padding="12,8">
                    <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource GhostButton}"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Click="ToggleDetails_Click"
                            ToolTip="Показать / скрыть панель с данными компонента — освобождает место для таблицы">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailToggleIcon"
                                       Text="&#xE89F;"
                                       Style="{StaticResource IconText}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="DetailToggleText"
                                       Text="Скрыть панель"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource BgInputBrush}"
                            BorderBrush="{DynamicResource BorderInputBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0"
                            Height="34"
                            Width="360"
                            HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE71E;"
                                       Style="{StaticResource IconText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"
                                     FontSize="13"/>
                        </Grid>
                    </Border>
                    </DockPanel>
                </Border>

                <!-- Filter tabs -->
                <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="8,0">
                    <Button Style="{StaticResource FilterTab}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static local:ComponentFilter.All}"
                            Tag="{Binding ActiveFilter, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=All}">
                        <TextBlock>
                            <Run Text="Все "/><Run Text="("/><Run Text="{Binding CountAll, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterTab}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static local:ComponentFilter.Matched}"
                            Tag="{Binding ActiveFilter, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Matched}">
                        <TextBlock>
                            <Run Text="Найдены "/><Run Text="("/><Run Text="{Binding CountMatched, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterTab}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="{x:Static local:ComponentFilter.Unresolved}"
                            Tag="{Binding ActiveFilter, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Unresolved}">
                        <TextBlock>
                            <Run Text="Не найдены "/><Run Text="("/><Run Text="{Binding CountUnresolved, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LIST + DETAIL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="DetailColumn"
                                  Width="320"
                                  MaxWidth="600"/>
            </Grid.ColumnDefinitions>

            <!-- List — two lines per component (name on top, type · family
                 below) so it fits narrow windows instead of six fixed-width
                 columns that needed ~1360 px in total. -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="ПОЗИЦИИ"
                                   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="НАИМЕНОВАНИЕ · ТИП · СЕМЕЙСТВО"
                                   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Column="2"
                                   Text="СТАТУС"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,0,34,0"/>
                    </Grid>
                </Border>

                <ListBox ItemsSource="{Binding FilteredComponents}"
                         SelectedItem="{Binding SelectedComponent}"
                         SelectionMode="Single"
                         AlternationCount="2"
                         BorderThickness="0"
                         Background="{DynamicResource BgAppBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="FocusVisualStyle"
                                    Value="{x:Null}"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex"
                                         Value="1">
                                    <Setter Property="Background"
                                            Value="{DynamicResource BgPanelBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProjectComponentVm}">
                            <Grid Margin="12,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Positions}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Positions}"
                                           Margin="0,2,12,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding TypeName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding FamilyName, Mode=OneWay, TargetNullValue='семейство не определено'}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border"
                                                   BasedOn="{StaticResource StatusBadge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchStatus}"
                                                                 Value="Matched">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource StatusSuccessBgBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchStatus}"
                                                                 Value="FamilyFound">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource StatusInfoBgBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchStatus}"
                                                                 Value="Unresolved">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource StatusWarningBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                                         Value="Matched">
                                                                <Setter Property="Fill"
                                                                        Value="{DynamicResource StatusSuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                                         Value="FamilyFound">
                                                                <Setter Property="Fill"
                                                                        Value="{DynamicResource StatusInfoBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                                         Value="Unresolved">
                                                                <Setter Property="Fill"
                                                                        Value="{DynamicResource StatusWarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                                         Value="Matched">
                                                                <Setter Property="Text"
                                                                        Value="Найден"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource StatusSuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                                         Value="FamilyFound">
                                                                <Setter Property="Text"
                                                                        Value="Семейство"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource StatusInfoBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                                         Value="Unresolved">
                                                                <Setter Property="Text"
                                                                        Value="Не найден"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource StatusWarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- "Ввести данные" — compact icon instead of a 140 px column;
                                         the same action also sits in the details pane. A fixed-size
                                         slot keeps the badges aligned whether it's shown or not. -->
                                    <Grid Width="28"
                                          Margin="6,0,0,0">
                                        <Button Content="&#xE70F;"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                FontSize="13"
                                                Padding="0"
                                                Width="28"
                                                Height="26"
                                                ToolTip="Ввести данные компонента"
                                                Command="{Binding DataContext.AddComponentDataCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MatchStatus}"
                                                                     Value="Unresolved">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchStatus}"
                                                                     Value="FamilyFound">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Draggable divider -->
            <GridSplitter x:Name="DetailSplitter"
                          Grid.Column="1"
                          Style="{StaticResource PaneSplitter}"
                          DragCompleted="DetailSplitter_DragCompleted"/>

            <!-- Detail panel -->
            <Grid Grid.Column="2"
                    Background="{DynamicResource BgSidebarBrush}">

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding SelectedComponent,
                    Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="&#xE9CE;"
                               Style="{StaticResource IconTextMuted}"
                               FontSize="32"/>
                    <TextBlock Text="Выберите компонент"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Component detail -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedComponent,
                      Converter={StaticResource NullToVis}}">

                    <Grid Background="{DynamicResource BgSidebarBrush}">
                        <StackPanel Margin="16"
                                DataContext="{Binding SelectedComponent}">

                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Positions}"
                                       Style="{StaticResource PositionsText}"
                                       Margin="0,0,0,16"/>

                            <!-- Unresolved / FamilyFound hint + button, mirrors the list-row action -->
                            <Border Padding="10,8"
                                    Margin="0,0,0,16"
                                    CornerRadius="6"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                    Value="Unresolved">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource StatusWarningBgBrush}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource StatusWarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MatchStatus}"
                                                    Value="FamilyFound">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource StatusInfoBgBrush}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource StatusInfoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                            FontWeight="Medium"
                                            TextWrapping="Wrap"
                                            Margin="0,0,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchStatus}"
                                                            Value="Unresolved">
                                                        <Setter Property="Text"
                                                                Value="Компонент не найден в каталоге"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource StatusWarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchStatus}"
                                                            Value="FamilyFound">
                                                        <Setter Property="Text"
                                                                Value="Семейство найдено, но не хватает данных по компоненту"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource StatusInfoBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Ввести данные компонента"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            Command="{Binding DataContext.AddComponentDataCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ПАРАМЕТРЫ ПО НТД"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Загрузка..."
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding IsLoadingNtd,
                               Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding NtdValues}"
                                          Focusable="False"
                                          Visibility="{Binding NtdLoaded,
                                  Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NtdParameterVm}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       Style="{StaticResource ParamValue}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
