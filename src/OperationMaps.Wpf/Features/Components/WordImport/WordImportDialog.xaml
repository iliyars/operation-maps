<Window x:Class="OperationMaps.Wpf.Features.Components.WordImport.WordImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OperationMaps.Wpf.Features.Components.WordImport"
        xmlns:controls="clr-namespace:OperationMaps.Wpf.Shared.Controls"
        Title="Импорт из Word"
        Width="820"
        Height="640"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgAppBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="Импорт из Word"
                        Style="{StaticResource TitleText}"/>
                <TextBlock Text="{Binding DocumentFileName}"
                        FontSize="12"
                        Margin="0,4,0,0"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Border Margin="0,10,0,0"
                        Padding="8,6"
                        CornerRadius="4"
                        Background="{DynamicResource StatusWarningBgBrush}"
                        Visibility="{Binding HasUnsupportedForms, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{DynamicResource StatusWarningBrush}">
                        <Run Text="Не поддерживаются (пропущены): Форма"/>
                        <Run Text="{Binding UnsupportedFormsDisplay, Mode=OneWay, StringFormat=' {0}'}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <!-- Loading -->
            <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Чтение документа..."
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Error -->
            <TextBlock Text="{Binding ErrorMessage}"
                    Margin="20"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource StatusErrorBrush}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"/>

            <!-- Rows -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Padding="20,12"
                    Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:WordImportRowVm}">
                            <Border Background="{DynamicResource BgPanelBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                            VerticalAlignment="Top"
                                            Margin="0,2,10,0"
                                            IsChecked="{Binding IsSelected}"
                                            IsEnabled="{Binding CanToggleSelection}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FullName}"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding OwnFormLabel}"
                                                FontSize="11"
                                                Margin="0,2,0,0"
                                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding FamilyDisplay, StringFormat='Семейство: {0}'}"
                                                FontSize="11"
                                                Margin="0,2,0,0"
                                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Warnings}"
                                                Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                            FontSize="11"
                                                            TextWrapping="Wrap"
                                                            Foreground="{DynamicResource StatusWarningBrush}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ImportError}"
                                                FontSize="11"
                                                Margin="0,4,0,0"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource StatusErrorBrush}"
                                                Visibility="{Binding ImportError, Converter={StaticResource NotNullToVis}}"/>
                                    </StackPanel>

                                    <!-- Resolved type: plain text, not editable (common/happy path). -->
                                    <TextBlock Grid.Column="2"
                                            Text="{Binding TypeText}"
                                            VerticalAlignment="Top"
                                            Margin="8,4,8,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Visibility="{Binding IsTypeResolved, Converter={StaticResource BoolToVis}}"/>

                                    <!-- No Form4 match, or a not-yet-cataloged type: free text, pre-filled
                                         from Word where available. Typing/picking re-resolves the family
                                         live; an unrecognized name is created as a new ComponentType on
                                         import instead of forcing a pick from a closed list. -->
                                    <controls:AutoCompleteComboBox Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Margin="8,0"
                                            Height="30"
                                            ItemsSource="{Binding DataContext.ComponentTypeOptions,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            Text="{Binding TypeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            DisplayMemberPath="Name"
                                            Visibility="{Binding ShowTypeEditor, Converter={StaticResource BoolToVis}}"/>

                                    <Border Grid.Column="3"
                                            VerticalAlignment="Top"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Background="{DynamicResource BgHoverBrush}">
                                        <TextBlock Text="{Binding StatusText}"
                                                FontSize="11"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                        Text="{Binding ResultSummary}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Button Grid.Column="1"
                        Content="Закрыть"
                        Style="{StaticResource OutlineButton}"
                        Padding="16,0"
                        Height="32"
                        Margin="0,0,8,0"
                        IsCancel="True"/>

                <Button Grid.Column="2"
                        Content="Импортировать"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ImportSelectedCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
