<UserControl x:Class="OperationMaps.Wpf.Features.TitlePage.TitlePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OperationMaps.Wpf.Features.TitlePage"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:TitlePageViewModel}"
             Background="{DynamicResource BgAppBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,14,16,16"
                    MaxWidth="560"
                    HorizontalAlignment="Left">

            <TextBlock Text="Титульный лист и содержание"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Данные, которые подставляются в титульный лист и содержание. Обозначение и наименование взяты из перечня элементов (XML) — их можно поправить. Руководителя программа запоминает для следующих проектов."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,20"/>

            <TextBlock Text="ИЗ ПЕРЕЧНЯ ЭЛЕМЕНТОВ"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Обозначение документа"
                       Style="{StaticResource ParamLabel}"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Наименование изделия"
                       Style="{StaticResource ParamLabel}"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,20"/>

            <TextBlock Text="РУКОВОДИТЕЛЬ"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Должность"
                       Style="{StaticResource ParamLabel}"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding HeadOccupation, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Фамилия и инициалы"
                       Style="{StaticResource ParamLabel}"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding HeadName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4"/>
            <TextBlock Text="Например: Иванов И.И."
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Заполните все поля — иначе в документе останутся пустые места."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusWarningBrush}"
                       Margin="0,0,0,10"
                       Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVis}}"/>

            <Button Style="{StaticResource PrimaryButton}"
                    Padding="14,6"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveWordCommand}">
                <TextBlock Text="Сохранить титульный лист в Word"/>
            </Button>
            <TextBlock Text="Файл «Титульный лист.docx» сохраняется в папку Forms рядом с картами. При сборке итогового документа он создаётся автоматически."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,8,0,28"/>

            <!-- Contents stamp: the people are typed in (remembered for the next project) -->
            <TextBlock Text="ШТАМП СОДЕРЖАНИЯ"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Разработал"
                       Style="{StaticResource ParamLabel}"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding DevelopedBy, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Проверил"
                       Style="{StaticResource ParamLabel}"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding CheckedBy, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Н. контроль"
                       Style="{StaticResource ParamLabel}"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding NormControl, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4"/>
            <TextBlock Text="Фамилии печатаются в основном штампе содержания. Программа запоминает их для следующих проектов."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,24"/>

            <!-- Contents preview: forms of the project with their sheets -->
            <TextBlock Text="СОДЕРЖАНИЕ"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Лист 1 — титульный, лист 2 — содержание, дальше формы по порядку. Число листов формы зависит от числа компонентов в ней."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,10"/>

            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Contents.Entries}"
                              Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="16,0,0,0">
                                        <Run Text="лист "/><Run Text="{Binding Sheets, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12">
                <Run Text="Всего листов в комплекте (графа «Листов» в штампе): "/><Run Text="{Binding Contents.TotalSheets, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>

            <Button Style="{StaticResource OutlineButton}"
                    Padding="14,6"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveContentsCommand}">
                <TextBlock Text="Сохранить содержание в Word"/>
            </Button>
            <TextBlock Text="Файл «Содержание.docx». Тоже создаётся автоматически при сборке итогового документа."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
