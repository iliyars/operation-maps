<UserControl x:Class="OperationMaps.Wpf.Features.Welcome.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgAppBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Начало работы" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="OperationMaps · Карты рабочих режимов ЭРИ" Style="{StaticResource SubtitleText}" Margin="0,6,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="240"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="4*" MinWidth="280"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Создать и открыть" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>
                    <Button Command="{Binding OpenXmlCommand}" Style="{StaticResource PrimaryButton}" Height="44">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Создать проект из ПЭ3"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OpenXmlCommand.IsRunning}" Value="True">
                                            <Setter Property="Text" Value="Импорт и сопоставление…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <TextBlock Text="Импортировать перечень элементов из XML и сопоставить его с каталогом."
                               Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,8,0,20"/>
                    <Button Content="Открыть проект…" Command="{Binding OpenProjectCommand}" Style="{StaticResource OutlineButton}" Height="40" ToolTip="Открыть файл .omaps (Ctrl+O)"/>
                    <TextBlock Text="Продолжить работу с сохранённым файлом .omaps."
                               Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,8,0,28"/>
                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Справочник" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <Button Content="Пополнить из Word" Command="{Binding ImportFromWordCommand}" Style="{StaticResource OutlineButton}" Height="36"/>
                            <TextBlock Text="Перенести данные из заполненного комплекта карт в каталог ЭРИ."
                                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Последние проекты" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>
                    <TextBlock Text="Открытие проекта…" Style="{StaticResource SubtitleText}" Margin="0,0,0,12"
                               Visibility="{Binding OpenRecentCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20"
                            Visibility="{Binding HasRecentProjects, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Здесь будут ваши проекты" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Откройте или сохраните проект — он появится в этом списке. Аварийные копии сюда не добавляются."
                                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource OutlineButton}" Height="Auto" HorizontalContentAlignment="Stretch" Padding="12,10" ToolTip="{Binding Path}">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Content="Убрать" Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="8,4,0,0" ToolTip="Убрать из списка. Файл останется на диске."/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Путь изменился? Откройте файл через «Открыть проект». Старую запись можно убрать из списка."
                               Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
