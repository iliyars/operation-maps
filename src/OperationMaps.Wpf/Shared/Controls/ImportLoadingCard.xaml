<UserControl x:Class="OperationMaps.Wpf.Shared.Controls.ImportLoadingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
          BorderThickness="1" CornerRadius="16" Padding="32,28">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
    <StackPanel>
      <Grid Width="56" Height="56" Margin="0,0,0,20" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="Spin">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:1.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Spin"/></Trigger.ExitActions>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Ellipse Margin="4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" Opacity="0.15"/>
        <Path Data="M 28,4 A 24,24 0 0 1 52,28" Stroke="{DynamicResource AccentBrush}"
              StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
      <TextBlock Text="{Binding BusyTitle}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                 TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="{Binding BusyText}" Margin="0,10,0,18" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
      <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                   IsIndeterminate="{Binding IsProgressIndeterminate}" Foreground="{DynamicResource AccentBrush}"
                   Background="{DynamicResource BgHoverBrush}" BorderThickness="0"/>
      <TextBlock Text="Можно отменить операцию или вернуться назад." Margin="0,14,0,16" TextAlignment="Center"
                 TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
      <Button Content="Отменить" Command="{Binding CancelOperationCommand}" Style="{StaticResource OutlineButton}"
              HorizontalAlignment="Center" Height="Auto" MinHeight="36" MinWidth="112" Padding="18,7"/>
    </StackPanel>
  </Border>
</UserControl>
