<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ── Ghost button (тулбар, без рамок как в VS Code) ──────────────── -->
  <Style x:Key="GhostButton"
      TargetType="Button">
    <Setter Property="Background"
        Value="Transparent"/>
    <Setter Property="BorderThickness"
        Value="0"/>
    <Setter Property="Foreground"
        Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Padding"
        Value="8,5"/>
    <Setter Property="FontSize"
        Value="12"/>
    <Setter Property="Cursor"
        Value="Hand"/>
    <Setter Property="Height"
        Value="28"/>
    <Setter Property="FocusVisualStyle"
        Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!--
            BorderThickness is reserved at 1px ALL the time (transparent
            when not focused) rather than growing 0->N only on focus. A v1
            that toggled thickness on IsKeyboardFocused made Save's own
            text overflow/clip the moment it got focus — the fixed-Height
            button's content area shrank by the border's thickness right
            as it appeared, since nothing was reserving that space
            beforehand. Keeping the size constant and only swapping the
            border's color avoids that class of bug entirely. 1px (not 2)
            because these buttons are short (28px) enough that 2px eats
            into the text's own vertical room.
          -->
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderThickness="1"
                  BorderBrush="Transparent"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                Value="True">
              <Setter TargetName="Bd"
                  Property="Background"
                      Value="{DynamicResource BgHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed"
                Value="True">
              <Setter TargetName="Bd"
                  Property="Background"
                      Value="{DynamicResource BgActiveBrush}"/>
            </Trigger>
            <!-- FocusVisualStyle is disabled (no dotted rectangle) — this
                 border is the ONLY indicator a keyboard user gets of which
                 button Tab landed on/Enter would activate. -->
            <Trigger Property="IsKeyboardFocused"
                Value="True">
              <Setter TargetName="Bd"
                  Property="BorderBrush"
                      Value="{DynamicResource BorderFocusBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled"
                Value="False">
              <Setter Property="Opacity"
                  Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Outline button (Разбить, Объединить) ────────────────────────── -->
  <Style x:Key="OutlineButton"
      TargetType="Button"
      BasedOn="{StaticResource GhostButton}">
    <Setter Property="BorderThickness"
        Value="1"/>
    <Setter Property="BorderBrush"
        Value="{DynamicResource BorderDefaultBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                Value="True">
              <Setter TargetName="Bd"
                  Property="Background"
                      Value="{DynamicResource BgHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed"
                Value="True">
              <Setter TargetName="Bd"
                  Property="Background"
                      Value="{DynamicResource BgActiveBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused"
                Value="True">
              <Setter TargetName="Bd"
                  Property="BorderBrush"
                      Value="{DynamicResource BorderFocusBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled"
                Value="False">
              <Setter Property="Opacity"
                  Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Primary button (Сохранить, ОК) ──────────────────────────────── -->
  <Style x:Key="PrimaryButton"
      TargetType="Button">
    <Setter Property="Background"
        Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground"
        Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="BorderThickness"
        Value="0"/>
    <Setter Property="Padding"
        Value="16,0"/>
    <Setter Property="Height"
        Value="32"/>
    <Setter Property="FontSize"
        Value="13"/>
    <Setter Property="Cursor"
        Value="Hand"/>
    <Setter Property="FocusVisualStyle"
        Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- Same fixed-thickness/color-only-on-focus approach as
               GhostButton/OutlineButton — see the comment there. -->
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderThickness="1"
                  BorderBrush="Transparent"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                Value="True">
              <Setter TargetName="Bd"
                  Property="Background"
                      Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused"
                Value="True">
              <Setter TargetName="Bd"
                  Property="BorderBrush"
                      Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled"
                Value="False">
              <Setter Property="Opacity"
                  Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Icon button (× удалить примечание) ──────────────────────────── -->
  <Style x:Key="IconButton"
      TargetType="Button"
      BasedOn="{StaticResource GhostButton}">
    <!-- Padding trimmed from 4 to 3: GhostButton's template now permanently
         reserves a 1px border (see its Template comment) instead of only
         on focus, and this button's fixed 20x20 size has no slack to
         absorb that without shrinking the icon's own room otherwise. -->
    <Setter Property="Padding"
        Value="3"/>
    <Setter Property="Height"
        Value="20"/>
    <Setter Property="Width"
        Value="20"/>
  </Style>
</ResourceDictionary>
