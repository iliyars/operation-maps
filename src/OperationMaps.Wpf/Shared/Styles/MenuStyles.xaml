<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WPF's default Menu/MenuItem chrome is the classic Windows look (white
    popups, blue highlight) regardless of app theme — jarring against a dark
    theme. Re-templated flat, VS Code style, driven by the same theme tokens
    as everything else so it follows light/dark automatically.
    Only what this app's menu actually uses is covered: a two-level menu
    (top-level header -> flat submenu items) and separators. No icons,
    checkable items, or nested sub-submenus — none of the menu content needs
    them, so there's no template branch for them.
  -->

  <ControlTemplate x:Key="TopLevelMenuItemTemplate"
      TargetType="MenuItem">
    <Grid>
      <Border x:Name="Bd"
              Background="Transparent"
              Padding="10,6">
        <ContentPresenter ContentSource="Header"
                          RecognizesAccessKey="True"/>
      </Border>
      <Popup x:Name="Popup"
             Placement="Bottom"
             HorizontalOffset="0"
             IsOpen="{TemplateBinding IsSubmenuOpen}"
             AllowsTransparency="True"
             Focusable="False"
             PopupAnimation="Fade"
             StaysOpen="False">
        <Border Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                Padding="2"
                MinWidth="200">
          <StackPanel IsItemsHost="True"
                      Orientation="Vertical"/>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver"
          Value="True">
        <Setter TargetName="Bd"
            Property="Background"
                Value="{DynamicResource BgHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsSubmenuOpen"
          Value="True">
        <Setter TargetName="Bd"
            Property="Background"
                Value="{DynamicResource BgActiveBrush}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="SubmenuMenuItemTemplate"
      TargetType="MenuItem">
    <Border x:Name="Bd"
            Background="Transparent"
            Padding="20,7">
      <ContentPresenter ContentSource="Header"
                        RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted"
          Value="True">
        <Setter TargetName="Bd"
            Property="Background"
                Value="{DynamicResource BgHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled"
          Value="False">
        <Setter Property="Opacity"
            Value="0.4"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground"
        Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontSize"
        Value="12"/>
    <Setter Property="FocusVisualStyle"
        Value="{x:Null}"/>
    <Setter Property="Template"
        Value="{StaticResource SubmenuMenuItemTemplate}"/>
    <Style.Triggers>
      <Trigger Property="Role"
          Value="TopLevelHeader">
        <Setter Property="Template"
            Value="{StaticResource TopLevelMenuItemTemplate}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Margin"
        Value="6,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{DynamicResource BorderDefaultBrush}"
                  Height="1"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Menu">
    <Setter Property="Background"
        Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Menu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="0,0,0,1">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
