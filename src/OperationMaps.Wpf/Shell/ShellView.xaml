<UserControl x:Class="OperationMaps.Wpf.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OperationMaps.Wpf.Shell"
             mc:Ignorable="d"
             d:DesignHeight="450"
        d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Section separator -->
        <DataTemplate x:Key="SeparatorTemplate"
                      DataType="{x:Type local:NavItemViewModel}">
            <Grid>
                <TextBlock Text="{Binding Label}"
                           Foreground="{DynamicResource SidebarSectionBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="14,14,12,2"
                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVis}}"/>
                <Border Height="1"
                        Margin="12,10,12,4"
                        Background="{DynamicResource BorderDefaultBrush}"
                        Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- Nav item -->
        <DataTemplate x:Key="NavItemTemplate"
                      DataType="{x:Type local:NavItemViewModel}">
            <Button Command="{Binding Command}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding Label}"
                    ToolTipService.InitialShowDelay="300"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- Active indicator bar + item -->
                        <Grid Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left accent bar (visible when active) -->
                            <Border Grid.Column="0"
                                    x:Name="AccentBar"
                                    Background="{DynamicResource SidebarAccentBrush}"
                                    Visibility="Collapsed"/>

                            <!-- Item background + content -->
                            <Border Grid.Column="1"
                                    x:Name="Bd"
                                    Background="Transparent"
                                    Margin="0,1,6,1"
                                    CornerRadius="4"
                                    Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15"
                                               x:Name="IconText"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               FontSize="13"
                                               x:Name="LabelText"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource SidebarHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarActiveBgBrush}"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Active -->
                            <DataTrigger Binding="{Binding IsActive}"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource SidebarActiveBgBrush}"/>
                                <Setter TargetName="AccentBar"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="IconText"
                                        Property="Foreground"
                                        Value="{DynamicResource SidebarActiveBrush}"/>
                                <Setter TargetName="LabelText"
                                        Property="Foreground"
                                        Value="{DynamicResource SidebarActiveBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <local:NavItemTemplateSelector x:Key="NavItemSelector"
                                       SeparatorTemplate="{StaticResource SeparatorTemplate}"
                                       NavItemTemplate="{StaticResource NavItemTemplate}"/>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: full (220) or icons only (52), like VS Code / Outlook -->
        <Grid Grid.Column="0"
              Background="{DynamicResource SidebarBgBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Width"
                            Value="236"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}"
                                     Value="True">
                            <Setter Property="Width"
                                    Value="52"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- app title    -->
                <RowDefinition Height="*"/>
                <!-- nav items    -->
                <RowDefinition Height="Auto"/>
                <!-- theme toggle -->
            </Grid.RowDefinitions>

            <!-- App title -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="7,8">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Свернуть / развернуть меню"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Width="38"
                                        Height="34"
                                        CornerRadius="6"
                                        Background="Transparent">
                                    <TextBlock Text="&#xE700;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="{DynamicResource SidebarHoverBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="OperationMaps"
                               Foreground="{DynamicResource SidebarActiveBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Nav items -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Padding="0,6,0,6">
                <ItemsControl ItemsSource="{Binding MainNavItems}"
                              ItemTemplateSelector="{StaticResource NavItemSelector}"
                              Focusable="False"/>
            </ScrollViewer>

            <!-- Theme toggle -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="6,6">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding SystemNavItems}" ItemTemplateSelector="{StaticResource NavItemSelector}" Margin="0,0,0,8"/>
                <Button Command="{Binding ToggleThemeCommand}"
                        ToolTip="{Binding ThemeLabel}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Padding="10,7"
                                    Margin="0,1,6,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ThemeIcon}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ThemeLabel}"
                                               FontSize="13"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter TargetName="Bd"
                                            Property="Background"
                                            Value="{DynamicResource SidebarHoverBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Divider -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderDefaultBrush}"/>

        <!-- Workspace and project status stay visible while switching screens. -->
        <Grid Grid.Column="2" Background="{DynamicResource BgAppBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="20,10" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding ProjectCaption}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectLocation}"/>
                        <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource SubtitleText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Сохранить" Command="{Binding SaveProjectCommand}" Style="{StaticResource OutlineButton}"
                                ToolTip="Сохранить проект (Ctrl+S)" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="Экспорт комплекта" Command="{Binding ExportReportCommand}" Style="{StaticResource PrimaryButton}" Padding="14,6"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentScreen}"/>
            <Border Grid.Row="2" Padding="20,6" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Grid Margin="0,2,0,4" Visibility="{Binding Operation.IsBusy, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.LiveSetting="Polite">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentBrush}"
                                     AutomationProperties.Name="Выполняется операция"/>
                        <TextBlock Grid.Column="1" Text="{Binding Operation.Message}" Margin="12,0,0,0"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Operation.Message}"/>
                    </Grid>
                    <Grid Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SaveStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProjectLocation}" FontSize="12" Margin="24,0,0,0"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding ProjectLocation}"/>
                    </Grid>
                    <TextBlock Text="Готово" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasProject}" Value="False"/>
                                            <Condition Binding="{Binding Operation.IsBusy}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
